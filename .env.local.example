# Turso (本番環境)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_auth_token

# ローカル開発 (デフォルト: SQLiteファイル使用)
# TURSO_DATABASE_URL=file:local.db

# ── 管理者認証（2つとも必須）────────────────────────────────────────

# 管理者パスワード: ログイン画面で入力するパスワード
# 英数字・記号を混ぜた十分に長いパスワードを設定すること
ADMIN_PASSWORD=your_strong_password_here

# セッショントークン: ブラウザの HttpOnly Cookie に格納されるランダム文字列
# パスワードとは別に生成すること（openssl rand -hex 32 で生成推奨）
ADMIN_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ⚠️ NEXT_PUBLIC_ADMIN_TOKEN は廃止・設定禁止
# （NEXT_PUBLIC_ プレフィックスはブラウザバンドルに埋め込まれるため危険）
