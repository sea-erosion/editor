# Turso (本番環境)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your_auth_token

# ローカル開発 (デフォルト: SQLiteファイル使用)
# TURSO_DATABASE_URL=file:local.db

# 管理API認証トークン（必須）
# openssl rand -hex 32 などで生成した十分に長いランダム文字列を設定すること
ADMIN_TOKEN=your_admin_token_here

# クライアントサイドから参照するトークン（管理画面フロントエンド用）
# ※ NEXT_PUBLIC_ プレフィックスにより公開されるため、本番環境では
#    IP制限やVPNと組み合わせてアクセスを制限することを推奨
NEXT_PUBLIC_ADMIN_TOKEN=your_admin_token_here
